# Шаблон змінних оточення. Скопіюйте у .env.local та заповніть.
# .env.local у .gitignore — реальні секрети туди, у репозиторій не потрапляють.

# --- Telegram (сповіщення про замовлення/відгуки) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# для застосування міграцій через Session pooler (одноразові node+pg скрипти)
SUPABASE_DB_URL_SP=

# --- Cloudflare R2 (зберігання фото товарів/банерів) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
